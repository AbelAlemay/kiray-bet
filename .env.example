# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Until these are set, the site shows the sample listings in src/lib/sample-listings.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Address of the site, used in sign-in links. Change to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "on" once Google sign-in is configured in Supabase.
NEXT_PUBLIC_GOOGLE_SIGN_IN=off

# Admin alerts for new listings (server-only; leave blank to skip a channel).
# Resend: resend.com → API Keys. Telegram: create a bot with @BotFather.
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sender for admin alerts; must be on the domain verified in Resend.
ALERT_FROM_EMAIL="KirayBet <alerts@kiraybet.org>"

# Bot check (Cloudflare Turnstile). These are Cloudflare's test keys, which always pass.
# Before launch: dash.cloudflare.com → Turnstile → add the site, use its real keys,
# and run `npx supabase config push` so Supabase uses the new secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
