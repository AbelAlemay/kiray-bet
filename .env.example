# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Until these are set, the site shows the sample listings in src/lib/sample-listings.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Address of the site, used in sign-in links. Change to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "on" once Google sign-in is configured in Supabase.
NEXT_PUBLIC_GOOGLE_SIGN_IN=off
